{
  "name": "dsh-windows-notifier",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: minimal Windows toast notification when a conversation/task completes.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "notification",
    "windows",
    "toast"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/bundle.js"
  },
  "dependencies": {
    "node-notifier": "^10.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
